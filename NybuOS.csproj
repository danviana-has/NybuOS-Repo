<Project Sdk="Cosmos.Sdk/3.0.95">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <VMMemory>2048</VMMemory>
    <VirtualBoxDisplayType>VBoxVGA</VirtualBoxDisplayType>
    <Features>experimental-data-section-string-literals</Features>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Core kernel packages -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.95" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.95" />
    <PackageReference Include="Cosmos.Network.Http" Version="3.0.0" />
    <PackageReference Include="LunarLabs.Fonts" Version="1.0.3" />
  </ItemGroup>

  <!-- Explicit reference for Roslyn compile-time type resolution -->
  <ItemGroup>
    <Reference Include="Cosmos.Kernel.System">
      <HintPath>$(UserProfile)\.nuget\packages\cosmos.kernel.system\3.0.95\runtimes\linux-x64\lib\net10.0\Cosmos.Kernel.System.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Cosmos.Kernel.HAL">
      <HintPath>$(UserProfile)\.nuget\packages\cosmos.kernel.hal\3.0.95\runtimes\linux-x64\lib\net10.0\Cosmos.Kernel.HAL.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Cosmos.Network.Http">
      <HintPath>$(UserProfile)\.nuget\packages\cosmos.network.http\3.0.0\lib\net10.0\Cosmos.Network.Http.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BouncyCastle.Cryptography">
      <HintPath>$(UserProfile)\.nuget\packages\bouncycastle.cryptography\2.7.0\lib\net6.0\BouncyCastle.Cryptography.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="LunarFonts">
      <HintPath>$(UserProfile)\.nuget\packages\lunarlabs.fonts\1.0.3\lib\netstandard2.0\LunarFonts.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
